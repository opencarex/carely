# Database (PostgreSQL 17 Alpine local / Supabase production)
DATABASE_URL=postgresql://carely_user:carely_password@localhost:5432/carely_db

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=carely-super-secret-key-at-least-32-chars-long

# Generic SMTP (Mailpit local / Google SMTP production)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Carely Hospital <no-reply@carely.local>"

# Application Settings Fallback
HOSPITAL_NAME="Carely Hospital"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Bootstrap System Administrator Account (Single email or comma-separated list; password min 12 chars)
ADMIN_EMAIL=admin@carely.local
# Example with multiple admins: ADMIN_EMAIL=admin1@carely.local, admin2@carely.local
ADMIN_PASSWORD=AdminPassword123!
