# Copy to .env.docker and replace placeholders before running Compose.
COMPOSE_PROJECT_NAME=carely
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3000
POSTGRES_PORT=5432
POSTGRES_USER=carely_user
POSTGRES_DB=carely_db
# Use a URL-safe random value (for example, 48 hexadecimal characters).
POSTGRES_PASSWORD=replace_with_random_hex_password
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace_with_a_random_secret_at_least_32_characters

# Mailpit captures local demo mail. Supply real SMTP settings for a deployment.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Carely Hospital <no-reply@carely.local>"
SMTP_TEST_PORT=1025
MAILPIT_PORT=8025
HOSPITAL_NAME="Carely Hospital"

# Used only by the explicit seed-admin command, not by the application service.
ADMIN_EMAIL=admin@carely.local
ADMIN_PASSWORD=replace_with_a_strong_password_at_least_12_characters
